# PARÁMETROS NORMALIZADOS DE TUNING PID SEGURO - ELECTRÓNICA PERLACO
# Vehículo: STR-002 H3 v3.0 (MTOW 29 kg) - Octocóptero Coaxial X8
# Escalado oficial ArduPilot Copter 4.2+

# --- GANANCIAS DE ACTITUD PITCH / ROLL (HEAVY LIFT) ---
ATC_ANG_PIT_P,4.500000
ATC_ANG_RLL_P,4.500000
ATC_ANG_YAW_P,3.800000

# --- BUCLE DE TASA RATE PID NORMALIZADO (RANGO SEGURO 0.05 - 0.12) ---
ATC_RAT_PIT_P,0.085000
ATC_RAT_PIT_I,0.085000
ATC_RAT_PIT_D,0.003500
ATC_RAT_PIT_IMAX,0.400000

ATC_RAT_RLL_P,0.085000
ATC_RAT_RLL_I,0.085000
ATC_RAT_RLL_D,0.003500
ATC_RAT_RLL_IMAX,0.400000

# --- BUCLE YAW ---
ATC_RAT_YAW_P,0.180000
ATC_RAT_YAW_I,0.018000
ATC_RAT_YAW_D,0.000000

# --- FILTROS Y TIEMPOS DE PROTECCIÓN ---
INS_ACCEL_FILTER,20
INS_GYRO_FILTER,20
INS_HNTC2_ENABLE,1
INS_HNTC2_MODE,1
INS_HNTC2_FREQ,45
INS_HNTC2_REF,0.18

MOT_PWM_MIN,1050
MOT_PWM_MAX,1950
MOT_SPIN_ARM,0.12
MOT_SPIN_MIN,0.15
