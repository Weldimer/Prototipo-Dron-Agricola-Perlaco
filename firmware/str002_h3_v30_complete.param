# ARCHIVO DE PARÁMETROS MAESTRO ARDUPILOT - ELECTRÓNICA PERLACO
# Vehículo: STR-002 H3 v3.0 (MTOW 29 kg)
# Controladora: Cube Orange+ (STM32H7)

# --- GEOMETRÍA Y MARCO ---
FRAME_CLASS,1
FRAME_TYPE,1
MIXING_GAIN,1.2

# --- FILTROS DE VIBRACIÓN Y NOTCH ARMÓNICO (HÉLICES 30") ---
INS_GYRO_FILTER,20
INS_HNTC2_ENABLE,1
INS_HNTC2_MODE,1
INS_HNTC2_FREQ,45
INS_HNTC2_REF,0.18
INS_HNTC2_ATT,40

# --- CONTROL PID DE ACTITUD HEAVY-LIFT ---
ATC_ANG_PIT_P,4.5
ATC_ANG_RLL_P,4.5
ATC_ANG_YAW_P,3.8
ATC_RAT_PIT_P,0.08
ATC_RAT_PIT_I,0.08
ATC_RAT_PIT_D,0.003
ATC_RAT_RLL_P,0.08
ATC_RAT_RLL_I,0.08
ATC_RAT_RLL_D,0.003

# --- NAVEGACIÓN RTK DUAL (MOVING BASELINE - SIN BRÚJULA) ---
EK3_SRC1_YAW,3
GPS_TYPE,22
GPS_TYPE2,23
GPS_AUTO_CONFIG,1
GPS_RATE_MS,100

# --- RADAR FMCW 77 GHz (TERRAIN FOLLOWING) ---
RNGFND1_TYPE,8
RNGFND1_MIN_CM,50
RNGFND1_MAX_CM,1000
RNGFND1_GNDCLEAR,20
WPNAV_RFND_ENABLE,1

# --- SALIDAS SERVO Y CONTROL VRA ---
SERVO9_FUNCTION,94
SCR_ENABLE,1
SCR_USER1,30.0
